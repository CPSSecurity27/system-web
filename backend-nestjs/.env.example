NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

DB_HOST=localhost
DB_PORT=5432
# La app corre como cps_web (roles de §13, ver docs/roles-conexion-v2.sql):
# la base misma le impide escribir device_state y tocar lo append-only.
DB_USER=cps_web
DB_PASSWORD=
DB_NAME=cps_security_v2
# Las migraciones necesitan DDL: el CLI de TypeORM usa estas credenciales admin.
# Si faltan, el CLI cae a DB_USER (útil si todavía no creaste los roles).
DB_MIGRATIONS_USER=postgres
DB_MIGRATIONS_PASSWORD=

# Firma los access tokens. Generar uno propio, NUNCA reusar este:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=cambiame-por-un-valor-random-de-al-menos-32-caracteres
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30

# SMTP. Sin SMTP_HOST los mails NO se envían: se loguean por consola.
# Gmail: SMTP_PASSWORD es una "contraseña de aplicación" (16 caracteres),
# NO la clave de la cuenta. Requiere 2FA activo:
#   https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu-cuenta@gmail.com
SMTP_PASSWORD=
SMTP_FROM=CPS Security <tu-cuenta@gmail.com>

# Base del front. El link de reseteo de contraseña apunta acá (no a la API).
FRONTEND_URL=http://localhost:5173

# Cifra los codigos RF de los controles (AES-256, 32 bytes en base64).
# Generar una propia, NUNCA reusar. Si se pierde, los codigos son irrecuperables.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
REMOTE_CODES_KEY=

# Descifra las credenciales del portal local de los equipos (usuarios admin/cps).
# Tiene que ser IDENTICA a GTD_CRED_KEY del provisioner, que es quien las cifra.
# Aca solo se descifra: la web no genera credenciales de equipo nunca.
#
# Los SALTS de derivacion NO van aca ni pueden ir: con un salt se calculan las
# credenciales de toda la flota. Viven solo en el provisioner.
CPS_CRED_KEY=

# Cuanto espera el alta de fabrica a que el provisioner confirme (ms). El alta es
# atomica: si vence, el equipo recien creado se borra. Incluye un reload de
# mosquitto sobre una Raspberry, asi que va holgado.
PROVISIONING_TIMEOUT_MS=30000

# Origenes permitidos por CORS (lista blanca, separados por coma).
# 4200 es el front de Angular (ng serve).
CORS_ORIGINS=http://localhost:5173,http://localhost:4200
